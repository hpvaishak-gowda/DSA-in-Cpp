      vector<int> ans;
      int n = mat.size();
      int m = mat[0].size();

      int i = 0;
      int j = 0;
      
      while (i < n && j < m) {
          
          ans.push_back(mat[i][j]);

          // Move right
          if (i == 0 && j < m - 1) {
              j++;
          }

          // Move down
          else if (j == m - 1 && i < n - 1) {
              i++;
          }

          // Move left
          else if (i == n - 1 && j > 0) {
              j--;
          }

          // Move up
          else if (j == 0 && i > 1) {
              i--;
          }

          else {
              break;
          }
      }

      return ans;
    }
};

