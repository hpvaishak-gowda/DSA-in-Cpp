  public:
    vector<int> boundaryTraversal(vector<vector<int>>& mat) {
        
        int n=mat.size();
        int m=mat[0].size();
        vector<int> ans;
        
        // Top
        
        for(int j=0;j<m;j++){
            int i=0;
            ans.push_back(mat[i][j]);
            
        }
        if(n==1){
                return ans;
        }
        
        // right
        
        for(int i=1;i<n;i++){
            int j=m-1;
            ans.push_back(mat[i][j]);
        }
        if(m==1){
            return ans;
            
        }
        
        // bottom
        
        for(int j=m-2;j>=0;j--){
            int i=n-1;
            
            ans.push_back(mat[i][j]);
            
        }
        
        // left
        
        for(int i=n-2;i>0;i--){
            int j=0;
            ans.push_back(mat[i][j]);
        }
    return ans;
    }
    
