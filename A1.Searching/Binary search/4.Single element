Chatgpt approach-

class Solution {
public:
    int single(vector<int>& arr) {

        int n = arr.size();

        int st = 0;
        int end = n - 1;

        while (st < end) {

            int mid = st + (end - st) / 2;

            // Make mid even
            if (mid % 2 == 1)
                mid--;

            if (arr[mid] == arr[mid + 1]) {
                // Pair is normal
                // Single element is to the right
                st = mid + 2;
            }
            else {
                // Pair is broken
                // Single element is at mid or to the left
                end = mid;
            }
        }

        return arr[st];
    }
};
