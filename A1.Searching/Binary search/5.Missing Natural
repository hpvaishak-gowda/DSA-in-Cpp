class Solution {
public:
    int missingNumber(vector<int>& arr) {
        int n = arr.size();

        int low = 0;
        int high = n - 1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (arr[mid] == mid + 1) {
                // Missing number is on the right
                low = mid + 1;
            }
            else {
                // Missing number is on the left or at mid
                high = mid - 1;
            }
        }

        return low + 1;
    }
};
