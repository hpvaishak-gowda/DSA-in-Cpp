class Solution {
public:
    int nthRoot(int n, int m) {
        int st=1;
        int end=m;
        
        if(n==1 || m==1){
            return m;
        }
        else if(m==0){
            return 0;
        }
        
        while(st<end){
            int mid = st+(end-st)/2;
            
            int comp=pow(mid,n);
            
            if(comp==m){
                return mid;
            }
            else if(comp > m){
                end=mid-1;
            }
            else{
                st=mid+1;
            }
        }
        return -1;
    }
};
