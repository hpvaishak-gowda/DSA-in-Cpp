class Solution {
  public:
    int minDiff(vector<int>& arr) {
        sort(arr.begin(),arr.end());
        int n=arr.size();
        vector<int> ans;
        
        for(int i=0;i<n-1;i++){
            
            int j=i+1;
            
            int diff=arr[j]-arr[i];
            
            ans.push_back(diff);
            
            
        }
        
        int small =INT_MAX;
        
        for(int i=0;i<ans.size();i++){
            small=min(small,ans[i]);
        }
        return small;
        
        
    }
};
