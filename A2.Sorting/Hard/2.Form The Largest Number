class Solution {
public:
    string findLargest(vector<int>& arr) {

        // Convert integers to strings
        vector<string> nums;

        for (int x : arr) {
            nums.push_back(to_string(x));
        }

        // Custom sorting
        sort(nums.begin(), nums.end(), [](string a, string b) {
            return a + b > b + a;
        });

        // If all numbers are 0
        if (nums[0] == "0")
            return "0";

        // Concatenate the sorted numbers
        string ans = "";

        for (string x : nums) {
            ans += x;
        }

        return ans;
    }
};






























