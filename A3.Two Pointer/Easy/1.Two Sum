class Solution {
	public:
	vector<int> twoSum(vector<int>& arr, int target) {
		int n=arr.size();
		int st =0;
		int end=n-1;
		vector<int>ans;
		
		while(st<=end){
		    int add;

		    add=arr[st]+arr[end];
		    
		    if(add==target){
		        ans.push_back(st+1);
		        ans.push_back(end+1);
		        return ans;
		    }
		    else if(add>target){
		        end--;
		    }
		    else{
		        st++;
		    }
		}
		ans.push_back(-1);
		ans.push_back(-1);
		return ans;
		
	}
};
