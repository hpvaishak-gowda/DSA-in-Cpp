#include <iostream>
#include <unordered_map>
using namespace std;

int main() {
int arr[] = {4, 2, 4, 3, 2, 4, 5, 3};
int n = sizeof(arr) / sizeof(arr[0]);


unordered_map<int, int> freq;

// Count the frequency of each element
for (int i = 0; i < n; i++) {
    freq[arr[i]]++;
}

// Print each element and its frequency
for (auto it : freq) {
    cout << it.first << " occurs "
         << it.second << " times" << endl;
}

return 0;

}
