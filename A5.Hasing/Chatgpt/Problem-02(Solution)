#include <iostream>
#include <unordered_map>
using namespace std;


 int main(){

    int arr[4]={1,1,1,1};
    int n=sizeof(arr)/sizeof(int);

    unordered_map<int,int> freq;

    for(int i=0;i<n;i++){
        freq[arr[i]]++;
    }

    for(auto it: freq){
        if(it.second != 1){
            cout<< "true";
            return 0;
        }
    }
    cout<< "false";
 }
