Corrct aprroach-

#include <iostream>
#include <map>
using namespace std;

int main() {
    int arr[] = {5, 2, 3};
    int n = sizeof(arr) / sizeof(arr[0]);

    map<int, int> freq;

    // Step 1: Count the frequency of each element
    for (int i = 0; i < n; i++) {
        freq[arr[i]]++;
    }

    // Step 2: Find the first unique element in the original array
    for (int i = 0; i < n; i++) {
        if (freq[arr[i]] == 1) {
            cout << arr[i];
            return 0;
        }
    }

    // Step 3: No unique element exists
    cout << -1;

    return 0;
}
