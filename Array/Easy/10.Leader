3. TC-O(n)

class Solution {
public:
    vector<int> leaders(vector<int>& arr) {
        int n = arr.size();
        vector<int> ans;

        int maxRight = arr[n - 1];
        ans.push_back(maxRight);

        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] >= maxRight) {
                maxRight = arr[i];
                ans.push_back(arr[i]);
            }
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
----------------------------------------------------------------------------------
4.TC-O(n2)
passed - 1110/1111 test cases-

class Solution {
	public:
	vector<int> leaders(vector<int>& arr) {
		
		int n = arr.size();
		vector<int>ans;
		
		for (int i = 0; i<n; i++) {
			
			for (int j = i; j<n; j++) {
				
				if (arr[i]<arr[j]) {
					break;
				}
				if (j == n - 1) {
					ans.push_back(arr[i]);
				}
				
			}
			
		}
		return ans;
		
	}
};

