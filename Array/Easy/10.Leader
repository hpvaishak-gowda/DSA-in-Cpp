1.
Passed test cases -1110/1111

class Solution {
	public:
	vector<int> leaders(vector<int>& arr) {
		int n = arr.size();
		vector<int> ans;
		int i,j;
		bool small=false;
		
		if(n==2){
		    
		    if(arr[0]>arr[1] || arr[0]==arr[1]){
		        return arr;
		    }
		    ans.push_back(arr[1]);
		    return ans;
	
		}
		
		
		
		for (i = 0; i<n; i++) {
			for ( j = i; j<n; j++) {
				
				if (arr[i]<arr[j]) {
					small=true;
					break;
				}
				
			}
			if(small != true){
			    ans.push_back(arr[i]);
			}
			small=false;
		}
		
		if(ans.size()==0){
		    ans.push_back(arr[n-1]);
		}
		
	
		return ans;
		
	}
};

