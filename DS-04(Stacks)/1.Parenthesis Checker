class Solution {
  public:
    int number(char z){
        if(z=='('|| z==')'){
            return 1;
        }
        else if(z=='{'||z=='}'){
            return 2;
        }
        else{
            return 3;
        }
    }
    
    bool isBalanced(string& s) {
        stack<char>st;
        
        for(int i=0;i<s.size();i++){
            
            char ch = s[i];
            
            if(ch == '(' || ch=='{' || ch =='['){
                st.push(ch);
            }
            else{
                if(st.empty()) return 0;
                int ktop = number(st.top());
                int k=number(ch);
                
                if(ktop==k){
                    st.pop();
                    
                }
                else{
                    return false;
                }
                
            }
        }
        if(!st.empty()){
            return 0;
            
        }
    }
};
