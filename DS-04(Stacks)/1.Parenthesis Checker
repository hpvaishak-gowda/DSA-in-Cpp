class Solution {
	public:
	
	int status(char ch) {
		switch (ch) {
			case '[':
			return 1; break;
			case '{':
			return 2; break;
			case '(':
			return 3; break;
			
			case ']':
			return 4; break;
			case '}':
			return 5; break;
			
			case ')':
			return 6; break;
			
			default:
			return -1;
		}
		return 0;
		
	}
	
	bool isBalanced(string& s) {
		
		stack<int>st;
		
		for (int i = 0; i<s.size(); i++) {
			char pivot = s[i];
			int k = status(pivot);
			
			if(st.empty() and k>3){
			    return false;
			}
			
			if (k == 1 || k == 2 || k == 3) {
				st.push(pivot);
			}
			else {
				if (k == 4 && st.top() == '[') {
					st.pop();
				}
				else if (k == 5 && st.top() == '{') {
					st.pop();
				}
				else if (k == 6 && st.top() == '(') {
					st.pop();
				}
				else {
					return false;
				}
			}
			
		}
		if (st.empty()) {
			return true;
		}
		else {
			return false;
		}
		
	}
};
