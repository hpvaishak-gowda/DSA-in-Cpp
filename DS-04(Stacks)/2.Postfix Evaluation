class Solution {
	public:
	int evaluatePostfix(vector<string>& arr) {
		stack<int>st;
		
		for (int i = 0; i<arr.size(); i++) {
			string ch = arr[i];
			
			if (ch != "+" && ch != "-" && ch != "/" && ch != "*" && ch != "^") {
				st.push(stoi(ch));
			}
			else {
			    if(st.size()<2){
			        return -1;
			    }
				int first = st.top();
				st.pop();
				int second = st.top();
				st.pop();
				
				switch (ch[0]) {
					case '+':
					st.push(second + first);break;
					
					case '-':
					st.push(second - first);break;
					
					case '*':
					st.push(second * first);break;
					
					case '/':
					st.push(floor((double)second/first));break;
					
					case '^':
					st.push(pow(second, first));break;
					
					default:
					return 1;
					
				}
			}
		}
		if(st.size()!= 1){
		    return -1;
		}
		return st.top();
	}
};
