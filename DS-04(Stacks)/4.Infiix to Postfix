class Solution {
public:

    int num(string p) {
        if (p == "^") {
            return 3;
        }
        else if (p == "*" || p == "/") {
            return 2;
        }
        else {
            return 1;
        }
    }

    string infixToPostfix(string& s) {
        string ans = "";
        stack<string> st;
        st.push("#");

        for (int i = 0; i < s.size(); i++) {
            string ch(1, s[i]);

            if (ch == "(") {
                st.push(ch);
            }
            else if (ch == ")") {
                while (st.top() != "(") {
                    ans += st.top();
                    st.pop();
                }
                st.pop();
            }
            else if (ch != "^" && ch != "+" && ch != "-" &&
                     ch != "*" && ch != "/") {
                ans += ch;
            }
            else {
                while (st.top() != "#" && st.top() != "(" &&
                      (num(st.top()) > num(ch) ||
                      (num(st.top()) == num(ch) && ch != "^"))) {

                    ans += st.top();
                    st.pop();
                }

                st.push(ch);
            }
        }

        while (st.top() != "#") {
            ans += st.top();
            st.pop();
        }

        return ans;
    }
};
