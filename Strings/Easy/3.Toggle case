class Solution {
	public:
	string toggleCase(string &s) {
	    
	    string ans="";
	    int n=s.size();
	    
	    for(int i=0;i<n;i++){
	        
	        if(s[i]>96){
	            char toggle=s[i]-32;
	            ans+=toggle;
	        }
	        else{
	            char toggle=s[i]+32;
	            ans+=toggle;
	        }
	        
	    }
	    return ans;
	    
	}
};
